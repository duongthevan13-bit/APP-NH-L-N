<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEPTHWALL VIP MAX"
            android:textStyle="bold"
            android:textSize="25sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ảnh: parallax 3D • Video: dừng ở khung hình cuối"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Chọn ảnh HẬU CẢNH" />

        <Button
            android:id="@+id/btnVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Chọn VIDEO làm hình nền động" />

        <Button
            android:id="@+id/btnFg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3. Chọn chủ thể PNG ĐÃ TÁCH NỀN (nổi 3D)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mẹo để nổi 3D tối đa: dùng ảnh chủ thể PNG nền trong suốt, tách nền thật sạch và chọn hậu cảnh khác với chủ thể."
            android:textSize="13sp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="4. XEM TRƯỚC / ĐẶT HÌNH NỀN VIP MAX" />
    </LinearLayout>
</ScrollView>
